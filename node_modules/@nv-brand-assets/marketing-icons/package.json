{
  "name": "@nv-brand-assets/marketing-icons",
  "version": "2.1.1",
  "license": "LicenseRef-NvidiaProprietary",
  "devDependencies": {
    "@nv-brand-assets/icon-tools": "^0.2.1",
    "@types/lodash-es": "^4.17.6",
    "@types/node": "^22.8.4",
    "figma-api": "^1.11.0",
    "lodash-es": "^4.17.21",
    "tsx": "^4.19.2",
    "typescript": "^5.0.4",
    "vite": "^5.1.0",
    "vite-tsconfig-paths": "^5.0.1"
  },
  "scripts": {
    "download": "tsx ./bin/download.mts",
    "build": "vite build && tsc -p tsconfig.build.json",
    "deploy": "./bin/deploy.sh"
  },
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "assets/",
    "dist/",
    "docs/"
  ],
  "publishConfig": {
    "registry": "https://urm.nvidia.com/artifactory/api/npm/sw-nvpubcloud-npm-local/"
  }
}
