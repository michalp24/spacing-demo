{
  "name": "@nv-brand-assets/marketing-icons-web-font",
  "version": "2.1.1",
  "license": "LicenseRef-NvidiaProprietary",
  "devDependencies": {
    "@nv-brand-assets/icon-tools": "^0.2.1",
    "@playwright/test": "^1.48.1",
    "@vitejs/plugin-react": "^4.3.2",
    "lodash-es": "^4.17.21",
    "playwright": "^1.48.1",
    "playwright-core": "^1.48.1",
    "prettier": "^3.3.3",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tsx": "^4.19.2",
    "typescript": "^5.0.4",
    "vite": "^5.1.0",
    "vite-plugin-static-copy": "^2.0.0",
    "vite-tsconfig-paths": "^5.0.1"
  },
  "scripts": {
    "generate:font-files": "tsx ./bin/generateFont.mts",
    "generate:prettier": "prettier --config ../../.prettierrc.json --write \"{src,assets}/*.{ts,css}\"",
    "generate": "npm run generate:font-files && npm run generate:prettier",
    "build": "vite build && tsc -p tsconfig.build.json",
    "deploy": "./bin/deploy.sh",
    "test": "playwright test",
    "test:dev": "npm run test -- --ui",
    "test:debug": "PWDEBUG=1 npm run test -- --ui",
    "test:server": "vite --config tests/server/test.config.ts --host"
  },
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs"
    },
    "./nvidia-marketing-icons.css": {
      "import": "./assets/nvidia-marketing-icons.css"
    },
    "./nvidia-marketing-icons-class.css": {
      "import": "./assets/nvidia-marketing-icons-class.css"
    },
    "./nvidia-marketing-icons.woff2": {
      "import": "./assets/nvidia-marketing-icons.woff2"
    },
    "./nvidia-marketing-icons.woff": {
      "import": "./assets/nvidia-marketing-icons.woff"
    },
    "./nvidia-marketing-icons.ttf": {
      "import": "./assets/nvidia-marketing-icons.ttf"
    }
  },
  "dependencies": {
    "@nv-brand-assets/marketing-icons": "^2.1.1"
  },
  "files": [
    "assets/",
    "dist/"
  ],
  "publishConfig": {
    "registry": "https://urm.nvidia.com/artifactory/api/npm/sw-nvpubcloud-npm-local/"
  }
}
